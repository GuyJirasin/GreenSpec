{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GREEN SPEC analysis result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "input_fingerprint",
    "generation_mode",
    "fixture_scenario_id",
    "status",
    "recommendations",
    "warnings",
    "errors"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "input_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "generation_mode": {
      "enum": [
        "simulated",
        "live"
      ]
    },
    "fixture_scenario_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "entity_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "lineage_id",
          "work_scope_key",
          "original_material",
          "proposed_material",
          "rationale",
          "quantity",
          "sources",
          "impacts",
          "methodology",
          "missing_data_reasons",
          "uncertainty_notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "lineage_id": {
            "type": "string",
            "minLength": 1
          },
          "work_scope_key": {
            "type": "string",
            "minLength": 1
          },
          "original_material": {
            "type": "string",
            "minLength": 1
          },
          "proposed_material": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "document_version_id",
                "exact_text",
                "locator"
              ],
              "properties": {
                "document_version_id": {
                  "type": "string",
                  "minLength": 1
                },
                "exact_text": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "enum": [
                        "page",
                        "paragraph",
                        "sheet_cell"
                      ]
                    },
                    "page_number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "paragraph_index": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sheet_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "cell_range": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "page"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "page_number"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "paragraph"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "paragraph_index"
                        ]
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "sheet_cell"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "sheet_name",
                          "cell_range"
                        ]
                      }
                    }
                  ]
                }
              }
            }
          },
          "impacts": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "baseline_cost_thb",
              "selected_cost_thb",
              "cost_saving_thb",
              "baseline_carbon_tco2e",
              "selected_carbon_tco2e",
              "carbon_reduction_tco2e"
            ],
            "properties": {
              "baseline_cost_thb": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "selected_cost_thb": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "cost_saving_thb": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "baseline_carbon_tco2e": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "selected_carbon_tco2e": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "carbon_reduction_tco2e": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "methodology": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "version",
              "basis"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "missing_data_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uncertainty_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "generation_mode": {
            "const": "simulated"
          }
        }
      },
      "then": {
        "properties": {
          "fixture_scenario_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "recommendations": {
            "maxItems": 0
          },
          "errors": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "recommendations": {
            "minItems": 1
          },
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
