# ==========================================
# GreenSpec AI Engine - Environment Configuration
# ==========================================

# --- OpenTyphoon API (SCB 10X Thai LLM) ---
# Sign up and get your API key at: https://opentyphoon.ai/
TYPHOON_API_KEY=your_typhoon_api_key_here
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v1.5-instruct

# --- Supabase Configuration (Database & Vector RAG) ---
# Project Settings > API in your Supabase dashboard: https://supabase.com/dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Server Configuration ---
PORT=8000
ENVIRONMENT=development
