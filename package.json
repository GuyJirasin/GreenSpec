{
  "name": "greenspec-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "dev:server": "node server/dev.mjs",
    "build:client": "cd frontend && npm run build",
    "build:server": "esbuild server/server.mjs --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js --packages=external",
    "build": "npm run build:client && npm run build:server",
    "test:shared": "node --test shared/*.test.mjs",
    "test:backend": "cd backend && npm test",
    "test:python": "PYTHONPATH=. pytest -v tests/",
    "test": "npm run test:shared",
    "test:api": "node --test tests/api_server.test.mjs tests/workflow.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "exceljs": "4.4.0",
    "hono": "^4.13.12",
    "jszip": "3.10.1",
    "pdf-parse": "2.4.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
